{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talibconnect-email",
  "main": "worker/contact-email.js",
  "compatibility_date": "2026-06-03",
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "contact@talibconnect.com",
    },
  ],
  "vars": {
    "TO_EMAIL": "contact@talibconnect.com",
    "CONTACT_FROM": "contact@talibconnect.com",
    "CORS_ORIGIN": "https://talibconnect.com,http://localhost:5173,http://127.0.0.1:5173",
  },

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
